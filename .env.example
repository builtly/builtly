# Copy to .env and replace secrets before running locally.
# Precedence: process env > .env > defaults.

BUILTLY_ENV=development
BUILTLY_HTTP_ADDR=:8080
BUILTLY_PUBLIC_URL=http://localhost:8080

BUILTLY_DB_DRIVER=sqlite
BUILTLY_DB_DSN=file:builtly.db
# BUILTLY_DB_DRIVER=postgres
# BUILTLY_DB_DSN=postgres://builtly:builtly@127.0.0.1:5432/builtly?sslmode=disable

BUILTLY_AUTO_MIGRATE=true
BUILTLY_LOG_LEVEL=info
BUILTLY_LOG_FORMAT=text
BUILTLY_WORKERS_ENABLED=false

# kid:base64(32+ bytes), comma-separated; first is active for signing
BUILTLY_JWT_SIGNING_KEYS=dev:qEoaBIE2I3L2faoeQTWiQjP+2V+/Ce1U+86KjIkasyg=
# version:base64(exactly 32 bytes); first is active for sealing
BUILTLY_ENCRYPTION_KEYS=1:eZlukPQGNLHYjsJFhveSsm3V0Kpy3Fj8Nt6Qp1At2Sc=

# >= 32 characters when admin enabled
BUILTLY_ADMIN_ENABLED=true
BUILTLY_ADMIN_TOKEN=ukfX1OPsLVywObS7p3dVtH3/bRdNqnsYZ9YzLSroIZA=
