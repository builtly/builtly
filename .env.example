# Unconfigured start → open /admin/#/setup (Public URL + DB).
# Precedence: process env > .env > data-dir file > defaults.
#
# Omit BUILTLY_PUBLIC_URL / DB / secrets to force the wizard.
# After setup (or for multi-node), put the wizard export into env / platform Secrets.

BUILTLY_ENV=development
BUILTLY_HTTP_ADDR=:8080
BUILTLY_DATA_DIR=./data
BUILTLY_LOG_LEVEL=info
BUILTLY_LOG_FORMAT=text
BUILTLY_WORKERS_ENABLED=false

# Optional convenience for local wizard (otherwise printed once in server logs):
# BUILTLY_SETUP_TOKEN=local-setup-token-change-me-please-32b

# Do not set these until after setup (or paste from wizard export):
# BUILTLY_PUBLIC_URL=http://localhost:8080
# BUILTLY_DB_DRIVER=sqlite          # or libsql (Turso) | postgres
# BUILTLY_DB_DSN=file:./data/builtly.db
# BUILTLY_AUTO_MIGRATE=true
# BUILTLY_JWT_SIGNING_KEYS=…
# BUILTLY_ENCRYPTION_KEYS=…
# BUILTLY_ADMIN_TOKEN=…
